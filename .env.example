# Required by the application server. Create these values in your Supabase project.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Set to the public URL used for auth email callbacks in production.
PUBLIC_APP_URL=http://localhost:3000
PORT=3000

# Needed for Gemini document OCR/classification. Upload processing reports a clear error when unset.
GEMINI_API_KEY=

# Optional: comma-separated addresses granted the workspace admin role.
ADMIN_EMAILS=

# Optional analytics; analytics remains disabled unless both values are set.
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# Optional government connector sandbox/production endpoints and bearer keys.
# Leave unset for the SIH demo; connectors are shown as not configured and no live checks are made.
UDYAM_API_URL=
UDYAM_API_KEY=
GSTN_API_URL=
GSTN_API_KEY=
INCOME_TAX_API_URL=
INCOME_TAX_API_KEY=
MCA21_API_URL=
MCA21_API_KEY=
STARTUP_INDIA_API_URL=
STARTUP_INDIA_API_KEY=
NSIC_API_URL=
NSIC_API_KEY=
EPFO_ESIC_API_URL=
EPFO_ESIC_API_KEY=
EPFO_API_URL=
EPFO_API_KEY=
ESIC_API_URL=
ESIC_API_KEY=
DIGILOCKER_API_URL=
DIGILOCKER_API_KEY=
MAKE_IN_INDIA_API_URL=
MAKE_IN_INDIA_API_KEY=
BIS_DPIIT_API_URL=
BIS_DPIIT_API_KEY=
DEBARMENT_API_URL=
DEBARMENT_API_KEY=
GEM_API_URL=
GEM_API_KEY=
